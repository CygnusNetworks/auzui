# Copy to .env (repo root, or services/gateway/.env) and adjust.
# Never commit real secrets. See docs/deployment.md for details.

# --- Zabbix (required) ---------------------------------------------------

ZABBIX_API_URL=https://zabbix-api.example.com/api_jsonrpc.php
# User-facing Zabbix UI ("im alten UI öffnen"-Links). Empty = derived from
# ZABBIX_API_URL.
ZABBIX_UI_URL=

# --- InfluxDB (optional — time-series fast path) -------------------------
# Leave all three empty to disable the Influx path; the SPA falls back to
# the Zabbix API (history.get/trend.get). See docs/timeseries-sources.md.

INFLUX_URL=
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=zabbix

# --- Graylog (optional — log panels) -------------------------------------
# Leave GRAYLOG_URL/GRAYLOG_TOKEN empty to disable the logs feature entirely.

GRAYLOG_URL=
GRAYLOG_TOKEN=
GRAYLOG_VERIFY_TLS=true
GRAYLOG_DEFAULT_STREAMS=
GRAYLOG_SOURCE_FIELD=source
GRAYLOG_BEARER_AUTH=false
# Cross-server log deduplication (only relevant with >1 Graylog server): when a
# host logs to several servers at once the same line arrives once per server.
# LOG_DEDUP_ENABLED gates both the collapsing and the frontend "merge
# duplicates" toggle (off by default). LOG_DEDUP_WINDOW_SECONDS is the max
# arrival-time spread that still counts as the same line (keep small so genuine
# periodic repeats survive).
LOG_DEDUP_ENABLED=false
LOG_DEDUP_WINDOW_SECONDS=2.0

# --- Docker (optional — container management) ----------------------------
# Leave DOCKER_HOSTS empty to disable the feature entirely. Full schema (all
# host/registry fields, connection variants, known_hosts): docs/configuration.md.

# DOCKER_HOSTS='[{"id":"prod-a","label":"prod-a","url":"http://docker-socket-proxy:2375","readonly":true}]'
# DOCKER_REGISTRIES='[{"registry":"ghcr.io","username":"bot","token":"..."}]'
DOCKER_TIMEOUT=10.0
DOCKER_CACHE_TTL=10.0
DOCKER_STATS_CACHE_TTL=5.0
DOCKER_UPDATE_CHECK_TTL=3600.0
# known_hosts file (read-only mount) required for any ssh:// entry in
# DOCKER_HOSTS; paramiko verifies against it with RejectPolicy, never
# AutoAddPolicy.
DOCKER_SSH_KNOWN_HOSTS=

# --- Optional config file (TOML/YAML) -------------------------------------
# Alternative to the ENV variables above: a mounted file can set ANY setting
# on this page (not just Docker). Precedence: ENV > .env > config file >
# default. See docs/configuration.md and examples/auzui.toml|auzui.yaml.

AUZUI_CONFIG_FILE=

# --- Serving the frontend from the gateway -------------------------------

AUZUI_SERVE_FRONTEND=false
FRONTEND_DIR=/app/static

# --- CORS -----------------------------------------------------------------
# CSV of allowed origins. Empty disables the CORS middleware (fine when the
# SPA is served from the same origin as the gateway).

CORS_ORIGINS=http://localhost:5173
