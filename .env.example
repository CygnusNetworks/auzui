# Copy to .env (repo root, or services/gateway/.env) and adjust.
# Never commit real secrets. See docs/deployment.md for details.

# --- Zabbix (required) ---------------------------------------------------

ZABBIX_API_URL=https://zabbix-api.example.com/api_jsonrpc.php
# User-facing Zabbix UI ("im alten UI öffnen"-Links). Empty = derived from
# ZABBIX_API_URL.
ZABBIX_UI_URL=

# --- InfluxDB (optional — time-series fast path) -------------------------
# Leave all three empty to disable the Influx path; the SPA falls back to
# the Zabbix API (history.get/trend.get). See docs/timeseries-sources.md.

INFLUX_URL=
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=zabbix

# --- Graylog (optional — log panels) -------------------------------------
# Leave GRAYLOG_URL/GRAYLOG_TOKEN empty to disable the logs feature entirely.

GRAYLOG_URL=
GRAYLOG_TOKEN=
GRAYLOG_VERIFY_TLS=true
GRAYLOG_DEFAULT_STREAMS=
GRAYLOG_SOURCE_FIELD=source
GRAYLOG_BEARER_AUTH=false

# --- Serving the frontend from the gateway -------------------------------

AUZUI_SERVE_FRONTEND=false
FRONTEND_DIR=/app/static

# --- CORS -----------------------------------------------------------------
# CSV of allowed origins. Empty disables the CORS middleware (fine when the
# SPA is served from the same origin as the gateway).

CORS_ORIGINS=http://localhost:5173
